# ==============================================================================
# Accelerate Financial Solutions - .gitignore
# Next.js App Router, TypeScript, Tailwind CSS, Node.js & Multi-Platform Tooling
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.yarn-integrity

# ------------------------------------------------------------------------------
# Next.js, Turbopack & Build Outputs
# ------------------------------------------------------------------------------
.next/
out/
build/
dist/
.turbo/
.cache/
.swc/

# ------------------------------------------------------------------------------
# TypeScript & Linting
# ------------------------------------------------------------------------------
*.tsbuildinfo
next-env.d.ts
.eslintcache
.stylelintcache

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (Prevent Accidental Leaks)
# ------------------------------------------------------------------------------
.env*
!.env.example
!.env*.example
!.env.sample
!.env*.sample
!.env.template
!.env*.template

# Certificates, Keys & Credentials
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.keystore
id_rsa*
credentials.json
auth.json

# ------------------------------------------------------------------------------
# Debug, Logs & Runtime State
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# Testing & Code Coverage
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov
.playwright/
test-results/
playwright-report/
blob-report/

# ------------------------------------------------------------------------------
# Deployment Platforms & Hosting
# ------------------------------------------------------------------------------
.vercel/
.serverless/
.terraform/

# ------------------------------------------------------------------------------
# Operating System & Filesystem Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

# Windows
[Tt]humbs.db
[Tt]humbs.db:encryptable
[Ee]hthumbs.db
[Ee]hthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# Editors & IDEs
# ------------------------------------------------------------------------------
# VS Code (preserve team workspace config, ignore local state)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
*.code-workspace
.history/

# JetBrains / WebStorm / IntelliJ
.idea/
*.iws
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs
*.swp
*.swo
\#*\#
.\#*

# ------------------------------------------------------------------------------
# AI Coding Assistants & Local Agent Sessions
# ------------------------------------------------------------------------------
.agents/
.agents
.gemini/
.claude/
.cursor/
.windsurf/
.aider*
.continue/

# ------------------------------------------------------------------------------
# Temporary & Scratch Files
# ------------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.patch
*.diff
